# ===========================================
# ColdMail — Environment Variables
# ===========================================
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# --- Clerk Auth ---
# Get these from https://clerk.com → Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Database (Neon Postgres) ---
# Get a free Postgres database from https://neon.tech
DATABASE_URL=

# --- Encryption ---
# 64 hex chars (32 bytes) for AES-256-GCM encryption of SMTP passwords
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- AI Configuration ---
# Groq (fast LLM) — get free key from https://console.groq.com
GROQ_API_KEY=

# Google Gemini AI (for smart company-specific cold emails)
# Get free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
